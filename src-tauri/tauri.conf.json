{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "可达",
  "version": "0.1.0",
  "identifier": "com.keda.chat",
  "build": {
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "可达",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#1A1A1A"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-capability"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "SocialNetworking",
    "shortDescription": "可达 IM",
    "longDescription": "可达即时通讯桌面客户端 (Linux)",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
